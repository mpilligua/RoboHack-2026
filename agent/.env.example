# Qwen multimodal (uni's OpenAI-compatible endpoint)
QWEN_BASE_URL=https://your-uni-endpoint.example.com/v1
QWEN_API_KEY=sk-replace-me
QWEN_MODEL=qwen2.5-vl-72b-instruct

# Lite3 — ROS 2 Foxy rosbridge host + port (camera, depth, leg_odom, cmd_vel,
# tracker /agent/* — one websocket shared by Lite3Robot + motion + follow + basic_goal)
ROS_BRIDGE_HOST=192.168.1.103
ROS2_BRIDGE_PORT=9091

# Nav2 via rosbridge: Foxy apt rosbridge 1.3.x does not support send_action_goal.
# Publish goals on navigation topic instead (adjust based on your robot):
# Standard Nav2 bt_navigator (PoseStamped):
#   NAV2_GOAL_POSE_TOPIC=/goal_pose
#   NAV2_GOAL_MESSAGE_TYPE=PoseStamped
# Lite3 custom basic_goal (Pose2D):
#   NAV2_GOAL_POSE_TOPIC=/basic_goal
#   NAV2_GOAL_MESSAGE_TYPE=Pose2D
# Optional: hide startup + tool hints when you know actions work:
# NAV_SUPPRESS_TOPIC_HINT=1

# If RGB/depth timeouts persist, set explicit ROS 2 topic names (see `ros2 topic list`):
# LITE3_RGB_TOPIC=/your/ns/color/image_raw
# LITE3_DEPTH_TOPIC=/your/ns/depth/image_rect_raw

# Camera fetch caps for python cli.py (Hz). Reduces bursts over rosbridge when the
# LLM calls vision tools often. Default when unset in cli: 2 Hz each.
# Set to 0 or negative for unlimited (not recommended on constrained WiFi).
# RGB_MAX_HZ=2
# DEPTH_MAX_HZ=2

# Bedrock (python cli.py path — see RUNBOOK for bearer token)
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_MODEL_ID=

# Optional: text-only model for the agent loop (defaults to QWEN_MODEL).
# AGENT_MODEL=qwen2.5-72b-instruct

# New pipeline — OpenAI-compatible endpoint (Bedrock compat, Qwen, or any provider)
# Point to AWS Bedrock OpenAI-compat:
#   AGENT_BASE_URL=https://bedrock.us-east-1.amazonaws.com/compatibility/v1
#   AGENT_API_KEY=<same bearer token as AWS_BEARER_TOKEN_BEDROCK>
#   AGENT_MODEL=us.anthropic.claude-opus-4-7-20251101-v1:0
# Or point to Qwen:
#   AGENT_BASE_URL=https://your-uni-endpoint.example.com/v1
#   AGENT_API_KEY=sk-replace-me
#   AGENT_MODEL=qwen2.5-vl-72b-instruct
#
# Set LEGACY_LOOP=1 to skip the new pipeline and use the legacy Bedrock Converse loop.
# LEGACY_LOOP=0
